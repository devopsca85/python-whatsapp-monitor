

{
  "monitoring": {
    "check_interval": 10,
    "timeout": 5
  },
  "system_monitoring": {
    "enabled": true,
    "check_interval": 20,
    "thresholds": {
      "cpu_percent": 30,
      "memory_percent": 30,
      "disk_percent": 30
    }
  },
  "database_monitoring": {
    "check_interval": 10,
    "timeout": 10,
    "enabled": true,
    "check_services": true,
    "send_alerts_always": true,
    "databases": {
      "mysql": {
        "enabled": true,
        "check_service_status": true,
        "check_databases": true,
        "check_tables": true,
        "check_corruption": true
      },
      "postgresql": {
        "enabled": true,
        "check_service_status": true,
        "check_databases": true,
        "check_tables": true
      },
      "mongodb": {
        "enabled": false,
        "check_service_status": false,
        "check_databases": false,
        "check_collections": false
      }
    }
  },
  "website_monitoring": {
    "check_interval": 300,
    "timeout": 5,
